      "Bash(curl -s -I http://127.0.0.1:8001/)",
      "Bash(curl -s -I http://127.0.0.1:8000/)",
      "Bash(curl -s -o /dev/null -w \"port 8000 status: %{http_code}\\\\n\" http://127.0.0.1:8000/)",
      "Bash(curl -s -o /dev/null -w \"port 8000: %{http_code}\\\\n\" http://127.0.0.1:8000/)",
      "Bash(curl -s -o /dev/null -w \"port 8001: %{http_code}\\\\n\" http://127.0.0.1:8001/)",
      "Bash(curl -s -o /dev/null -w \"hospital_system \\(8000\\): %{http_code}\\\\n\" http://127.0.0.1:8000/)",
      "Bash(curl -s -o /dev/null -w \"pharmacy dev server \\(8001\\): %{http_code}\\\\n\" http://127.0.0.1:8001/)"
