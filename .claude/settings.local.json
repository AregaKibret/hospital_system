      "Bash(python manage.py shell -c ' *)",
      "Bash(pip freeze *)",
      "PowerShell(pip install waitress 2>&1)",
      "PowerShell(Stop-Process -Id 16664 -Force -ErrorAction SilentlyContinue)",
