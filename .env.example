# Hospital Management System — environment configuration template.
# Copy to `.env` and fill in real values. Never commit `.env` itself (it's gitignored).
#
# Every variable below is actually read by hospital_system/settings.py via python-decouple —
# nothing here is speculative. See docs/CONFIGURATION.md for full explanations.

# ── Core Django settings ──────────────────────────────────────────────────────

# Django's cryptographic signing key (sessions, CSRF tokens, password reset tokens, etc.).
# Required — there is no default. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Never reuse a development key in production, and never commit a real one.
SECRET_KEY=your-secret-key-here

# True for local development (verbose error pages, no host-header enforcement beyond
# ALLOWED_HOSTS). MUST be False in any environment reachable by real users.
DEBUG=True

# Comma-separated list of hostnames this Django instance is allowed to serve.
# Add your domain here in production (e.g. hospital.example.com). On Render.com deployments,
# the platform's own hostname is appended to this list automatically at runtime — no action needed.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────────────────────────
# Two ways to configure the database — use ONE of them:
#
# 1) DATABASE_URL — a single connection string, checked FIRST. If set, it wins and the
#    DB_* variables below are ignored entirely. This is the path used on Render.com
#    (render.yaml injects it automatically from the managed Postgres instance) and is the
#    simplest option for any other cloud/managed Postgres provider.
#    Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgres://hospital_user:secret@localhost:5432/hospital_db

# 2) Individual DB_* variables — used only when DATABASE_URL is not set (the typical local
#    development path against a Postgres instance running on your own machine).
DB_NAME=hospital_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# Seconds a database connection is kept open and reused before Django closes it. 0 disables
# connection persistence (a new connection per request) — 60 is a reasonable default for both
# local dev and small production deployments.
DB_CONN_MAX_AGE=60

# ── Variables commonly expected but NOT used by this application ────────────────
# The application currently has no integration for any of the following. Setting them has
# no effect — they are listed here only so you don't spend time hunting for where they're
# read. See docs/CONFIGURATION.md for the full explanation of each gap.
#
#   EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD  — no email backend configured
#   Any SMS gateway variable (e.g. TWILIO_*)                         — no SMS integration exists
#   REDIS_URL / CELERY_BROKER_URL                                    — no cache layer or task queue
#   STORAGE_CONFIGURATION / AWS_* / cloud storage variables           — local disk (MEDIA_ROOT) only
#   LOG_LEVEL                                                         — Django's default logging is used, unconfigured
#
# STATIC_ROOT, STATIC_URL, MEDIA_ROOT, and MEDIA_URL are also NOT environment variables here —
# they are fixed paths hardcoded in hospital_system/settings.py (staticfiles/ and media/
# relative to the project root) and are not meant to be overridden per-environment.
